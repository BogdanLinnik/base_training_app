# Постгрес (у проді — з Vercel Storage / Neon)
DATABASE_URL="postgresql://training:training@localhost:5432/training"
# Пряме (не pooled) з'єднання, потрібне Prisma для міграцій на Neon/Vercel Postgres
DIRECT_URL="postgresql://training:training@localhost:5432/training"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (див. README.md — розділ "Google OAuth Client ID")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Тільки для локальної розробки/тестів! НІКОЛИ не вмикати на проді (Vercel).
ALLOW_TEST_LOGIN="true"
