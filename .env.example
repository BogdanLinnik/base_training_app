# Постгрес. Локально — Docker Postgres. У проді — Prisma Postgres на
# Vercel; його env var зазвичай названо DATABAS_POSTGRES_URL (Vercel
# префіксує ім'я, якщо DATABASE_URL уже зайняте — див. README). Ім'я
# змінної тут має збігатися з prisma/schema.prisma.
DATABAS_POSTGRES_URL="postgresql://training:training@localhost:5432/training"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (див. README.md — розділ "Google OAuth Client ID")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
